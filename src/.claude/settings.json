{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /d/claudeproject && venv/Scripts/python.exe -m unittest discover -s tests 2>&1",
            "timeout": 30,
            "statusMessage": "Running unit tests..."
          }
        ]
      }
    ]
  }
}
